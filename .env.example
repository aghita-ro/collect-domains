# --- Auction platform login ---
SCRAPER_USERNAME=
SCRAPER_PASSWORD=

# --- PostgreSQL ---
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Mailgun (EU endpoint) ---
MAILGUN_DOMAIN=
MAILGUN_API_KEY=
EMAIL_FROM=
EMAIL_TO=

# --- Gmail IMAP (auto-read eureg.ro 2FA login code) ---
# Use a Google "App Password" (requires 2-Step Verification on the account),
# NOT the normal Gmail password. Enables fully automatic login (no manual code).
GMAIL_IMAP_USER=
GMAIL_IMAP_PASSWORD=
GMAIL_IMAP_HOST=imap.gmail.com

# --- Webhook / container ---
WEBHOOK_TOKEN=change-me-long-random-secret
WEBHOOK_ALLOWED_IPS=
RANDOM_DELAY_MAX_MIN=0
